# Local PostgreSQL container (docker compose). Copy to .env and choose your own values.
# Placeholders only: never commit a real password.
POSTGRES_USER=approval_flow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=approval_flow
# Host port for the container; 5432 is often taken by a local PostgreSQL install.
POSTGRES_PORT=5433

# Used only by `docker compose --profile app up --build`, which runs the whole application in containers.
# Password of the five seeded demo accounts (secret): 10-128 characters with a letter and a digit. This placeholder
# is deliberately too short and has no digit, so the seed refuses an unedited copy of this file.
DEMO_USER_PASSWORD=CHANGE-ME
# Host port of the application container (127.0.0.1 only), and the browser origin that may send POST requests:
# CLIENT_ORIGINS must be exactly the address you open in the browser, or every sign-in answers 403.
APP_PORT=3000
CLIENT_ORIGINS=http://localhost:3000
