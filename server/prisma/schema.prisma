// Approval Flow data model. See docs/system-sds.md §3 and the F-05 contract §2.3.
// Naming: PascalCase models map to snake_case tables and columns; the API's JSON uses camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  REVIEWER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  // Stored trimmed and lowercased.
  email        String   @unique @db.VarChar(254)
  // scrypt$N$r$p$salt$hash (password.ts); never returned by the API.
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions Session[]

  requestsSubmitted ApprovalRequest[] @relation("RequestRequester")
  requestsAssigned  ApprovalRequest[] @relation("RequestReviewer")
  requestsDecided   ApprovalRequest[] @relation("RequestDecider")
  requestEvents     RequestEvent[]

  // "user" is a reserved word in PostgreSQL.
  @@map("app_user")
}

model Session {
  id        Int      @id @default(autoincrement())
  // SHA-256 hex of the cookie token; the token itself is never stored.
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

enum RequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}

enum RequestEventType {
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  RESUBMITTED
}

// Why a request was rejected (BR-12, F-04 contract section 2.3). The list is fixed. The CHECK constraints that keep a
// category off everything but a rejection are in the migration add_rejection_category_rules.
enum RejectionCategory {
  BUDGET
  INCOMPLETE
  DUPLICATE
  POLICY
  OTHER

  @@map("rejection_category")
}

// A purchase or funding request (SDS section 3, F-03 contract section 2.3). The model is named ApprovalRequest so
// the type never clashes with the global Request type.
//
// The number default, the named CHECK constraints, and the append-only trigger are in the migration
// add_request_rules, because Prisma cannot express them.
model ApprovalRequest {
  id                 Int           @id @default(autoincrement())
  // REQ- plus six digits, generated by the database from request_number_seq (BR-07); the client never sets it.
  requestNumber      String        @unique(map: "request_number_unique") @default(dbgenerated("('REQ-'::text || lpad((nextval('request_number_seq'::regclass))::text, 6, '0'::text))")) @map("request_number") @db.VarChar(10)
  requesterId        Int           @map("requester_id")
  assignedReviewerId Int           @map("assigned_reviewer_id")
  title              String        @db.VarChar(120)
  description        String        @db.VarChar(2000)
  amount             Decimal       @db.Decimal(12, 2)
  status             RequestStatus @default(SUBMITTED)
  decidedById        Int?          @map("decided_by_id")
  decisionReason     String?       @map("decision_reason") @db.VarChar(1000)
  decisionCategory   RejectionCategory? @map("decision_category")
  decidedAt          DateTime?     @map("decided_at") @db.Timestamptz
  // 0 at submission, one higher after each resubmission (BR-16, F-06 contract section 1.1).
  revision           Int           @default(0)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  requester        User           @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedReviewer User           @relation("RequestReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  decidedBy        User?          @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  events           RequestEvent[]

  @@index([requesterId, createdAt])
  @@index([assignedReviewerId, status])
  @@map("request")
}

// The history of a request: one row per status change, never updated or deleted (BR-13).
model RequestEvent {
  id         Int              @id @default(autoincrement())
  requestId  Int              @map("request_id")
  actorId    Int              @map("actor_id")
  type       RequestEventType
  fromStatus RequestStatus?   @map("from_status")
  toStatus   RequestStatus    @map("to_status")
  reason     String?          @db.VarChar(1000)
  category   RejectionCategory?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt, id])
  @@map("request_event")
}
