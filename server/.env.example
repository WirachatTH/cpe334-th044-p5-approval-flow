# Server and seed configuration. Copy to server/.env and choose your own values.
# Placeholders only: never commit real values. Every variable is described in docs/labs/lab-05/deployment.md.

# PostgreSQL connection string (secret). Locally it points at the docker compose database on port 5433.
DATABASE_URL=postgresql://approval_flow:change-me@localhost:5433/approval_flow?schema=public

# development | test | production
NODE_ENV=development

# HTTP port (Cloud Run sets it in the cloud).
PORT=3000

# Allowed browser origins for POST requests, comma-separated. Required when NODE_ENV=production.
CLIENT_ORIGINS=http://localhost:5173

# Password for the four seeded demo accounts (secret): 10-128 characters with a letter and a digit.
# Choose your own; it is never printed. This placeholder is deliberately too short and has no digit, so the seed
# refuses an unedited copy of this file instead of creating accounts with a public password.
DEMO_USER_PASSWORD=CHANGE-ME
